{
  "name": "saizen",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.28.2",
  "scripts": {
    "dev": "pnpm --filter @saizen/web dev",
    "build": "pnpm --filter @saizen/shared build && pnpm --filter @saizen/web build",
    "build:web": "pnpm --filter @saizen/web build",
    "sync:ios": "pnpm build:web && pnpm --filter @saizen/mobile sync",
    "open:ios": "pnpm --filter @saizen/mobile open:ios"
  },
  "engines": {
    "node": ">=20"
  }
}
