# Saizen — public OAuth client IDs (safe to ship in the app).
# Users sign in with THEIR AniList/MAL accounts; they never create these.
#
# Register once as the Saizen developer:
#   AniList → https://anilist.co/settings/developer
#     Redirect: saizen://anilist/callback
#   MAL → https://myanimelist.net/apiconfig
#     App type: "iOS" or "other" (public client + PKCE — NO client secret; not "web")
#     Redirect: saizen://mal/callback
#
# Copy to apps/web/.env.local (gitignored) then rebuild / sync:ios
#
# NEVER put client secrets in NEXT_PUBLIC_* — they ship in the JS bundle / IPA.
# MAL must be a public client; PKCE alone authenticates the token exchange.

NEXT_PUBLIC_ANILIST_CLIENT_ID=
NEXT_PUBLIC_MAL_CLIENT_ID=
